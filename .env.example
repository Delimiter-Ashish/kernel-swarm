# Copy to .env (gitignored) and fill in ONE provider. Never commit .env.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# LLM_BASE_URL=http://localhost:8000/v1    # local vLLM server

# Model: optional for Claude (defaults to claude-sonnet-5-5), required for others
# LLM_MODEL=
